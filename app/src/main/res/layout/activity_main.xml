<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- FONDOS DESLIZABLES -->
    <ViewFlipper
        android:id="@+id/viewFlipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- FrameLayout Cocina -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Fondo -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/fondo1"
                android:scaleType="centerCrop"/>

            <ImageView
                android:id="@+id/imgComida"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_comida"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_margin="150dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="bottom|center_horizontal"
                android:layout_marginBottom="40dp">
                <!-- Elementos encima -->

                <Button
                    android:id="@+id/btnAlimentar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alimentar"
                    android:background="@drawable/button_style"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="@null"
                    android:layout_marginStart="10dp"/>

                <Button
                    android:id="@+id/btnNevera"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Nevera"
                    android:background="@drawable/button_style"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="@null"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
        </FrameLayout>

        <!-- Frame Layout Dormitorio -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Fondo -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/fondo3"
                android:scaleType="centerCrop"/>

            <!-- Elementos encima -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="bottom|center_horizontal"
                android:layout_marginBottom="40dp">

                <Button
                    android:id="@+id/btnDormir"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dormir"
                    android:background="@drawable/button_style"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="@null"
                    android:layout_marginStart="10dp"/>

                <Button
                    android:id="@+id/btnLogros"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Coche"
                    android:background="@drawable/button_style"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="@null"
                    android:layout_marginStart="10dp"/>

            </LinearLayout>

        </FrameLayout>


<!-- FrameLayout Sala de juegos-->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Fondo -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/fondo2"
                android:scaleType="centerCrop"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="bottom|center_horizontal"
                android:layout_marginBottom="40dp">

                <Button
                    android:id="@+id/btnJugar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jugar"
                    android:background="@drawable/button_style"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="@null"
                    android:layout_marginStart="10dp"/>

                <Button
                    android:id="@+id/btnCoche"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Coche"
                    android:background="@drawable/button_style"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="@null"
                    android:layout_marginStart="10dp"/>

                <Button
                    android:id="@+id/btnMinigame"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Minijuegos"
                    android:background="@drawable/button_style"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="@null"
                    android:layout_marginStart="10dp"/>

            </LinearLayout>

        </FrameLayout>



    </ViewFlipper>

    <!-- UI ENCIMA -->
    <LinearLayout
        android:id="@+id/layoutMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp">

        <!-- Flechas -->
        <LinearLayout
            android:paddingTop="50dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnFlecha1"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/flechaizquierda"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"/>

            <Space
                android:layout_width="20dp"
                android:layout_height="1dp"/>

            <ImageButton
                android:id="@+id/btnFlecha2"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/flechaderecha"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"/>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="40dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:background="#66000000"
            android:padding="12dp">

            <!-- Hambre -->
            <!--
            <TextView
                android:text="Hambre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/> -->

            <FrameLayout
                android:layout_marginHorizontal="8dp"
                android:id="@+id/boxHambre"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/stat_border"
                android:clipToOutline="true">



                <View
                    android:id="@+id/fillHambre"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="bottom"
                    android:background="#4CAF50"/>

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_hambre"
                    android:layout_gravity="center"/>

            </FrameLayout>

            <!-- Energía -->
            <!--
            <TextView
                android:text="Energía"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/> -->

            <TextView
                android:id="@+id/testHambre"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Prueba"/>

            <FrameLayout
                android:layout_marginHorizontal="8dp"
                android:id="@+id/boxEnergia"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/stat_border"
                android:clipToOutline="true">

                <View
                    android:id="@+id/fillEnergia"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="bottom"
                    android:background="#4CAF50"/>

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_energia"
                    android:layout_gravity="center"/>

            </FrameLayout>

            <!-- Felicidad -->
            <!--
            <TextView
                android:text="Felicidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/> -->

            <FrameLayout
                android:id="@+id/boxFelicidad"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/stat_border"
                android:clipToOutline="true"
                android:layout_marginHorizontal="8dp">

                <View
                    android:id="@+id/fillFelicidad"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="bottom"
                    android:background="#4CAF50"/>

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_felicidad"
                    android:layout_gravity="center"/>

            </FrameLayout>

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="45dp"/>

        <!-- Mascota -->
        <ImageView
            android:id="@+id/imgMascota"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/ic_mascota"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

</FrameLayout>