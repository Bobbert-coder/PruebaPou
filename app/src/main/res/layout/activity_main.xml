<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- FONDOS DESLIZABLES -->
    <ViewFlipper
        android:id="@+id/viewFlipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- FrameLayout Cocina -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Fondo -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/fondo1"
                android:scaleType="centerCrop"/>

            <ImageView
                android:id="@+id/imgComida"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_comida"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_margin="150dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="bottom|center_horizontal"
                android:layout_marginBottom="40dp">
                <!-- Elementos encima -->

                <Button
                    android:id="@+id/btnAlimentar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alimentar"
                    android:background="@drawable/button_style"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="@null"
                    android:layout_marginStart="10dp"/>

                <Button
                    android:id="@+id/btnNevera"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Nevera"
                    android:background="@drawable/button_style"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="@null"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>

        </FrameLayout>

        <!-- Frame Layout Dormitorio -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Fondo -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/fondo3"
                android:scaleType="centerCrop"/>

            <!-- Elementos encima -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="bottom|center_horizontal"
                android:layout_marginBottom="40dp">

                <Button
                    android:id="@+id/btnDormir"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dormir"
                    android:background="@drawable/button_style"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="@null"
                    android:layout_marginStart="10dp"/>

                <Button
                    android:id="@+id/btnLogros"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Coche"
                    android:background="@drawable/button_style"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="@null"
                    android:layout_marginStart="10dp"/>

            </LinearLayout>

        </FrameLayout>


<!-- FrameLayout Sala de juegos-->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Fondo -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/fondo2"
                android:scaleType="centerCrop"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="bottom|center_horizontal"
                android:layout_marginBottom="40dp">

                <Button
                    android:id="@+id/btnJugar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jugar"
                    android:background="@drawable/button_style"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="@null"
                    android:layout_marginStart="10dp"/>

                <Button
                    android:id="@+id/btnCoche"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Coche"
                    android:background="@drawable/button_style"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="@null"
                    android:layout_marginStart="10dp"/>

                <Button
                    android:id="@+id/btnMinigame"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Minijuegos"
                    android:background="@drawable/button_style"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="@null"
                    android:layout_marginStart="10dp"/>

            </LinearLayout>

        </FrameLayout>



    </ViewFlipper>

    <!-- UI ENCIMA -->
    <LinearLayout
        android:id="@+id/layoutMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="30dp">

            <!-- IZQUIERDA: MONEDAS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="start|center_vertical"
                android:layout_gravity="center_vertical"
                android:background="@drawable/hud_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_moneda"
                    android:layout_gravity="center_horizontal"
                    android:scaleType="centerInside"/>

                <TextView
                    android:id="@+id/txtMonedas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="9999"
                    android:textColor="#FFD54F"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:paddingStart="6dp"/>

            </LinearLayout>

            <!-- CENTRO: FLECHAS -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal|center_vertical"
                android:background="@android:color/transparent"
                android:padding="12dp">

                <FrameLayout
                    android:layout_marginHorizontal="3dp"
                    android:id="@+id/boxHambre"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/stat_border"
                    android:clipToOutline="true">

                    <View
                        android:id="@+id/fillHambre"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="bottom"
                        android:background="#4CAF50"/>

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/ic_hambre"
                        android:layout_gravity="center"/>

                </FrameLayout>

                <FrameLayout
                    android:layout_marginHorizontal="3dp"
                    android:id="@+id/boxEnergia"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/stat_border"
                    android:clipToOutline="true">

                    <View
                        android:id="@+id/fillEnergia"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="bottom"
                        android:background="#4CAF50"/>

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/ic_energia"
                        android:layout_gravity="center"/>

                </FrameLayout>

                <FrameLayout
                    android:id="@+id/boxFelicidad"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/stat_border"
                    android:clipToOutline="true"
                    android:layout_marginHorizontal="3dp">

                    <View
                        android:id="@+id/fillFelicidad"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="bottom"
                        android:background="#4CAF50"/>

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/ic_felicidad"
                        android:scaleType="centerInside"
                        android:layout_gravity="center"/>

                </FrameLayout>

            </LinearLayout>

            <!-- DERECHA VACÍA -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp">

            <!-- IZQUIERDA: MONEDAS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="start|center_vertical"
                android:layout_gravity="center_vertical"
                android:background="@android:color/transparent"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp">

                <ImageButton
                    android:id="@+id/btnFlecha1"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/flechaizquierda"
                    android:background="@android:color/transparent"
                    android:scaleType="fitCenter"
                    android:layout_gravity="right"/>

            </LinearLayout>


            <!-- CENTRO -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:gravity="center"
                android:background="@android:color/transparent"
                android:padding="12dp">

                <TextView
                    android:id="@+id/txtHabitacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cocina"
                    android:textAlignment="center"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:textSize="20sp"
                    android:maxLines="2" />

            </LinearLayout>

            <!-- DERECHA VACÍA -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="start|center_vertical"
                android:layout_gravity="center_vertical"
                android:background="@android:color/transparent"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp">

                <ImageButton
                    android:id="@+id/btnFlecha2"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/flechaderecha"
                    android:background="@android:color/transparent"
                    android:scaleType="fitCenter"
                    android:layout_gravity="left"/>

            </LinearLayout>

        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

        </LinearLayout>



        <Space
            android:layout_width="match_parent"
            android:layout_height="45dp"/>

        <!-- Mascota -->
        <ImageView
            android:id="@+id/imgMascota"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/ic_mascota"
            android:layout_marginBottom="20dp"/>



    </LinearLayout>

    <Button
        android:id="@+id/btnTienda"
        android:layout_width="100dp"
        android:layout_height="50dp"
        android:layout_gravity="bottom|right"
        android:text="Tienda"/>

</FrameLayout>