<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- FONDOS DESLIZABLES -->
    <ViewFlipper
        android:id="@+id/viewFlipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- FrameLayout Cocina -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Fondo -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/fondo1"
                android:scaleType="centerCrop"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="bottom|center_horizontal"
                android:layout_marginBottom="40dp">
                <!-- Elementos encima -->
                <Button
                    android:id="@+id/btnAlimentar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alimentar"
                    android:layout_marginStart="10dp"/>

                <Button
                    android:id="@+id/btnNevera"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Nevera"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
        </FrameLayout>


<!-- FrameLayout Sala de juegos-->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Fondo -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/fondo2"
                android:scaleType="centerCrop"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="bottom|center_horizontal"
                android:layout_marginBottom="40dp">

                <Button
                    android:id="@+id/btnJugar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jugar"
                    android:layout_marginStart="10dp"/>

                <Button
                    android:id="@+id/btnCoche"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Coche"
                    android:layout_marginStart="10dp"/>

            </LinearLayout>

            <!-- Elementos encima -->


        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Fondo -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/fondo3"
                android:scaleType="centerCrop"/>

            <!-- Elementos encima -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="bottom|center_horizontal"
                android:layout_marginBottom="40dp">

                <Button
                    android:id="@+id/btnDormir"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dormir"
                    android:layout_marginStart="10dp"/>

                <Button
                    android:id="@+id/btnLogros"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Coche"
                    android:layout_marginStart="10dp"/>

            </LinearLayout>

        </FrameLayout>

    </ViewFlipper>

    <!-- UI ENCIMA -->
    <LinearLayout
        android:id="@+id/layoutMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp">

        <!-- Flechas -->
        <LinearLayout
            android:paddingTop="50dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnFlecha1"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/flechaizquierda"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"/>

            <Space
                android:layout_width="20dp"
                android:layout_height="1dp"/>

            <ImageButton
                android:id="@+id/btnFlecha2"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/flechaderecha"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"/>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="90dp"/>

        <!-- Mascota -->
        <ImageView
            android:id="@+id/imgMascota"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/ic_launcher_foreground"
            android:layout_marginBottom="20dp"/>

        <!-- Hambre -->
        <TextView
            android:text="Hambre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <ProgressBar
            android:id="@+id/progressHambre"
            style="?android:attr/progressBarStyleHorizontal"
            android:max="100"
            android:progress="50"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"/>

        <!-- Energía -->
        <TextView
            android:text="Energía"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <ProgressBar
            android:id="@+id/progressEnergia"
            style="?android:attr/progressBarStyleHorizontal"
            android:max="100"
            android:progress="50"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"/>

        <!-- Felicidad -->
        <TextView
            android:text="Felicidad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <ProgressBar
            android:id="@+id/progressFelicidad"
            style="?android:attr/progressBarStyleHorizontal"
            android:max="100"
            android:progress="50"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"/>


    </LinearLayout>

</FrameLayout>