<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:elevation="3dp"
    android:background="@drawable/bg_item_comida">

    <ImageView
        android:id="@+id/imgDecoracion"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:background="@drawable/bg_icono_comida" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/txtNombreDecoracion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Decoración"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPrecioDecoracion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Monedas"
            android:textSize="14sp"
            android:textColor="#FFE082"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />

    </LinearLayout>

    <Button
        android:id="@+id/btnComprarDecoracion"
        android:layout_width="96dp"
        android:layout_height="44dp"
        android:text="Comprar"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_btn_comprar"
        android:elevation="4dp"
        android:padding="0dp" />

</LinearLayout>