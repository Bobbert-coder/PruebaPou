<!-- MENU NEVERA -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menuNevera"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#88000000"
    android:visibility="visible"
    >

    <!-- Panel -->
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:background="#DD222222"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selecciona comida"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp"/>

        <!-- Comidas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnManzana"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/ic_manzana"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:adjustViewBounds="true"/>

            <ImageButton
                android:id="@+id/btnPizza"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/ic_pizza"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:adjustViewBounds="true"
                android:background="@android:color/transparent"/>

            <ImageButton
                android:id="@+id/btnHamburguesa"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/ic_comida"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:adjustViewBounds="true"
                android:background="@android:color/transparent"/>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>