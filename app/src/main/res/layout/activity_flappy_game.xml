<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutFlappy"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#87CEEB">

    <TextView
        android:id="@+id/txtScoreFlappy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Puntos: 0"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_margin="20dp"
        android:elevation="10dp" />

    <View
        android:id="@+id/tuboArriba"
        android:layout_width="90dp"
        android:layout_height="250dp"
        android:background="#2E7D32" />

    <View
        android:id="@+id/tuboAbajo"
        android:layout_width="90dp"
        android:layout_height="300dp"
        android:background="#2E7D32" />

    <ImageView
        android:id="@+id/imgPlayerFlappy"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/ic_mascota"
        android:scaleType="centerInside" />

    <include
        android:id="@+id/layoutGameOver"
        layout="@layout/layout_game_over"/>

</FrameLayout>